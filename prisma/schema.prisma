generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  slug        String    @unique
  description String    @default("")
  image       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products    Product[]

  @@map("categories")
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  description String    @default("")
  price       Int
  image       String?
  categoryId  Int
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images      ProductImage[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([categoryId])
  @@map("products")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  url       String
  order     Int      @default(0)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

model Admin {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt     DateTime @default(now())

  @@map("admins")
}
