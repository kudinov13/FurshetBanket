# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma sqlite database
/prisma/dev.db
/prisma/dev.db-journal

# uploaded images (managed at runtime)
/public/uploads/

# prisma sqlite database (any name)
/prisma/*.db
/prisma/*.db-journal

# dev tool configs
.devin/

# root-level database (if any)
/dev.db
/dev.db-journal

# source assets folder (not needed in repo, optimized versions in public/)
/Video/
